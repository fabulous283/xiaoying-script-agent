# Mock mode needs no environment variables. Real mode reads .env in the working directory.
# Existing process environment variables take precedence. Values are not interpolated.
# PowerShell : $env:SCRIPT_AGENT_BASE_URL = "https://your-provider.example/v1"
SCRIPT_AGENT_BASE_URL=https://your-provider.example/v1
SCRIPT_AGENT_MODEL=your-model-name
SCRIPT_AGENT_API_KEY=
# Read timeout is per network read ; connect timeout is 10 seconds.
SCRIPT_AGENT_READ_TIMEOUT_SECONDS=180
SCRIPT_AGENT_MAX_TOKENS=4096
# Optional provider extension : blank omits the parameter ; false disables thinking.
SCRIPT_AGENT_ENABLE_THINKING=
